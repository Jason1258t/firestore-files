{
  "name": "firestore-files",
  "version": "0.1.0",
  "description": "Файлы в Firestore кусками — без Firebase Storage и тарифа Blaze. Конфиг коллекции, лимитов и генератор правил.",
  "keywords": [
    "firebase",
    "firestore",
    "storage",
    "files",
    "upload",
    "chunks",
    "react"
  ],
  "author": "Jason <ivandomogatskij@gmail.com>",
  "homepage": "https://github.com/Jason1258t/firestore-files#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jason1258t/firestore-files.git"
  },
  "bugs": {
    "url": "https://github.com/Jason1258t/firestore-files/issues"
  },
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./rules": {
      "types": "./dist/rules-entry.d.ts",
      "default": "./dist/rules-entry.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    }
  },
  "bin": {
    "firestore-files": "./bin/cli.mjs"
  },
  "files": [
    "dist",
    "bin"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/unit.test.ts",
    "test:emulator": "npm run build && firebase emulators:exec --only firestore --project demo-firestore-files \"node --test --test-concurrency=1 test/*.emulator.test.ts test/emulator.test.ts\"",
    "prepublishOnly": "npm test",
    "prepack": "npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "peerDependencies": {
    "firebase": ">=10.0.0",
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "firebase": "^12.19.0",
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "~6.0.2"
  },
  "engines": {
    "node": ">=22.18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
